    rdfs:label "RECEIVED_AT" ;
    rdfs:domain ww:Shipment ;
    rdfs:range ww:Plant .

ww:REFERS_TO a owl:ObjectProperty ;
    rdfs:label "REFERS_TO" ;
    rdfs:domain ww:Alias .

ww:SCHEDULED_AT a owl:ObjectProperty ;
    rdfs:label "SCHEDULED_AT" ;
    rdfs:domain ww:ProductionOrder ;
    rdfs:range ww:Plant .

ww:SENT_BY a owl:ObjectProperty ;
    rdfs:label "SENT_BY" ;
    rdfs:domain ww:Shipment ;
    rdfs:range ww:Supplier .

ww:SOLD_THROUGH a owl:ObjectProperty ;
    rdfs:label "SOLD_THROUGH" ;
    rdfs:domain ww:CustomerOrder ;
    rdfs:range ww:Dealer .

ww:SUPPLIES a owl:ObjectProperty ;
    rdfs:label "SUPPLIES" ;
    rdfs:domain ww:Supplier ;
    rdfs:range ww:Part .

