ww:DELIVERS a owl:ObjectProperty ;
    rdfs:label "DELIVERS" ;
    rdfs:domain ww:Shipment ;
    rdfs:range ww:Part .

ww:FULFILLS a owl:ObjectProperty ;
    rdfs:label "FULFILLS" ;
    rdfs:domain ww:ProductionOrder ;
    rdfs:range ww:CustomerOrder .

ww:HAS_POOL a owl:ObjectProperty ;
    rdfs:label "HAS_POOL" ;
    rdfs:domain ww:Dealer ;
    rdfs:range ww:LoanerPool .

ww:INSTALLED_AT a owl:ObjectProperty ;
    rdfs:label "INSTALLED_AT" ;
    rdfs:domain ww:PartLot ;
    rdfs:range ww:Plant .

ww:LOT_FROM a owl:ObjectProperty ;
    rdfs:label "LOT_FROM" ;
    rdfs:domain ww:PartLot ;
    rdfs:range ww:Supplier .

ww:LOT_OF a owl:ObjectProperty ;
    rdfs:label "LOT_OF" ;
    rdfs:domain ww:PartLot ;
    rdfs:range ww:Part .

ww:MENTIONS a owl:ObjectProperty ;
    rdfs:label "MENTIONS" ;
    rdfs:domain ww:Event .

ww:ORDERED_BY a owl:ObjectProperty ;
    rdfs:label "ORDERED_BY" ;
    rdfs:domain ww:CustomerOrder ;
    rdfs:range ww:Customer .

ww:OWNED_BY a owl:ObjectProperty ;
    rdfs:label "OWNED_BY" ;
    rdfs:domain ww:Vehicle ;
    rdfs:range ww:Customer .

