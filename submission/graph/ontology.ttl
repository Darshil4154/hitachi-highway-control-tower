@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ww: <https://wackywheels.example/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ww:AFFECTS a owl:ObjectProperty ;
    rdfs:label "AFFECTS" ;
    rdfs:domain ww:Incident .

ww:AT_DEALER a owl:ObjectProperty ;
    rdfs:label "AT_DEALER" ;
    rdfs:domain ww:Vehicle ;
    rdfs:range ww:Dealer .

