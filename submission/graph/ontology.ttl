ww:BUILDS a owl:ObjectProperty ;
    rdfs:label "BUILDS" ;
    rdfs:domain ww:ProductionOrder ;
    rdfs:range ww:Model .

ww:BUILT_FROM a owl:ObjectProperty ;
    rdfs:label "BUILT_FROM" ;
    rdfs:domain ww:Vehicle ;
    rdfs:range ww:ProductionOrder .

ww:CAN_BUILD a owl:ObjectProperty ;
    rdfs:label "CAN_BUILD" ;
    rdfs:domain ww:Plant ;
    rdfs:range ww:Model .

